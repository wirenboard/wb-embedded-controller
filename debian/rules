#!/usr/bin/make -f
# You must remove unused comment lines for the released package.
#export DH_VERBOSE = 1
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

# Base path for the coverage report (without extension), set by Jenkins:
# DEB_BUILD_OPTIONS="... cov-report=<path>" (see Jenkinsfile). If the option is given
# more than once (buildDebSbuild Coverage stage appends its own), the last one wins
COV_REPORT := $(lastword $(patsubst cov-report=%,%,$(filter cov-report=%,$(DEB_BUILD_OPTIONS))))

%:
	dh $@

# Unit tests already run during the build (MODEL_% depends on unittests): when the report
# is requested, only their coverage is collected (COVERAGE_SKIP_RUN=1), without the submodules
# (coverage-project), as in CI of the libwbmcu-system firmwares
ifneq ($(COV_REPORT),)
ifeq ($(filter nocheck,$(DEB_BUILD_OPTIONS)),)
override_dh_auto_test:
	dh_auto_test
	$(MAKE) coverage-project COVERAGE_SKIP_RUN=1
	cp covr_report_project/coverage.xml $(COV_REPORT).xml
endif
endif

#override_dh_auto_install:
#	dh_auto_install -- prefix=/usr

#override_dh_install:
#	dh_install --list-missing -X.pyc -X.pyo

#!/usr/bin/make -f
# You must remove unused comment lines for the released package.
#export DH_VERBOSE = 1
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

# Base path for the coverage report (without extension), set by the Jenkins
# Coverage stage: DEB_BUILD_OPTIONS="... cov-report=<path>"
COV_REPORT := $(patsubst cov-report=%,%,$(filter cov-report=%,$(DEB_BUILD_OPTIONS)))

# Never generate .html coverage reports in package build (CI): they contain source code
# and also slow down the build, only .xml report is generated
export COVERAGE_NO_HTML = 1

%:
	dh $@

# Unit tests already run during the build (MODEL_% depends on unittests),
# here we only collect coverage when the report is requested
ifneq ($(COV_REPORT),)
ifeq ($(filter nocheck,$(DEB_BUILD_OPTIONS)),)
override_dh_auto_test:
	dh_auto_test
	$(MAKE) coverage COV_REPORT=$(COV_REPORT)
endif
endif

#override_dh_auto_install:
#	dh_auto_install -- prefix=/usr

#override_dh_install:
#	dh_install --list-missing -X.pyc -X.pyo
